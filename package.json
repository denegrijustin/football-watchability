{
  "name": "football-watchability",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm validate:data && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "import:legacy": "node scripts/import-legacy.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "playwright test",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name football-watchability"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.139.0"
  },
  "packageManager": "pnpm@11.19.0"
}
